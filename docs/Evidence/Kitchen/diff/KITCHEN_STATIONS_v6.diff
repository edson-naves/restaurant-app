+    @event.listens_for(engine, "connect")
+    def _fk(dbapi, _rec):  # noqa: ANN001
+        dbapi.execute("PRAGMA foreign_keys=ON")
+
+    Base.metadata.create_all(engine)
+    Sess = sessionmaker(bind=engine, future=True)
