# Copy to `.env` and edit. This file is filled in for LOCAL DEVELOPMENT, so the
# app runs with no secret to generate:
#
#   cp .env.example .env    # then edit the values marked CHANGE ME
#
# FOR PRODUCTION — including `docker compose up`, which is the on-prem
# production stack — three edits are REQUIRED. Each is repeated at its own
# variable below:
#
#   1. APP_ENV=production
#   2. SECRET_KEY=<a real key, at least 32 bytes>   (uncomment it)
#   3. DELETE the ALLOW_INSECURE_DEV_SECRET line entirely
#
# Compose enforces 2 by itself: docker-compose.yml reads
# `SECRET_KEY: ${SECRET_KEY:?set SECRET_KEY in .env}`, so it refuses to start
# while the key is still commented out. It also defaults APP_ENV to production.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=rms
# REQUIRED — compose refuses to start without it. Use a long random string.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=restaurant

# --- Deployment environment ----------------------------------------------
# UNSET OR BLANK MEANS PRODUCTION. A deployment that does not declare itself is
# treated as production and FAILS CLOSED on a missing SECRET_KEY or a partial
# Square config (see app/config.py). Lenient behaviour is opt-in, never a
# default: one of development / dev / local / test / testing / ci.
#
# PRODUCTION: set this to `production`. Leaving it out has the same effect, but
# say it explicitly so the deployment is self-describing.
APP_ENV=development

# --- First-run owner account ---------------------------------------------
# Used once by `python -m app.bootstrap` to create the single owner login on a
# fresh database. 4–8 digits. Change it after first sign-in under Manage.
OWNER_PIN=CHANGE_ME

# --- Session/PIN signing key ---------------------------------------------
# Signs login session cookies (app/security.py). It does NOT take part in PIN
# hashing — PINs use PBKDF2 with a per-PIN random salt, independent of this key.
# REQUIRED. The app refuses to start without it: session cookies are signed with
# this value, and a missing key used to fall back silently to a public one baked
# into the source. At least 32 bytes (UTF-8). Changing it signs everyone out on
# the next request, which is the safe failure mode.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Length is a floor, not a guarantee — 32 bytes of "aaaa..." passes the check and
# is still weak. Use the generator above, not a phrase you invented.
#
# LOCAL DEVELOPMENT: leave SECRET_KEY genuinely UNSET (comment the line out) and
# set ALLOW_INSECURE_DEV_SECRET=1 below. The opt-out only covers an ABSENT key —
# a key that is present but empty, too short, whitespace-padded or equal to the
# public development value is rejected in every environment.
#
# PRODUCTION: set SECRET_KEY here and delete the ALLOW_INSECURE_DEV_SECRET line.
# The opt-out is NOT enough on its own: with APP_ENV=production (or unset),
# validate_startup_config() requires a real SECRET_KEY and deliberately ignores
# ALLOW_INSECURE_DEV_SECRET — the opt-out belongs to the signing key, not to
# deployment configuration. A production .env that keeps the opt-out and omits
# the key does not start.
#SECRET_KEY=

# Local development only. Falls back to the public development key when
# SECRET_KEY is absent. Only the literal "1" enables it — "true", "yes", "0" and
# anything else leave the key mandatory.
#
# PRODUCTION: DELETE this line. Do not set it to 0 — delete it.
ALLOW_INSECURE_DEV_SECRET=1

# Set to 1 in production (behind HTTPS, e.g. Render) so the session cookie is
# only ever sent over TLS. Leave unset for local HTTP development.
# COOKIE_SECURE=1

# The restaurant's timezone — all "today"/date logic runs in it. Defaults to
# America/Vancouver (Pacific). Render's servers are UTC, so set this to your
# venue's zone or "today" can be off by a day. Use a TZ database name.
# TZ=America/Vancouver

# --- Square terminal payments (app/services/square.py) --------------------
# Cash-only venue? Leave these unset. To enable card payments set the THREE
# server-side vars together — ACCESS_TOKEN + LOCATION_ID + DEVICE_ID — a partial
# set aborts startup so card payments never silently fail.
# SQUARE_APPLICATION_ID is optional and NOT validated: the server-side Terminal
# flow never reads it (it's only a client-side SDK value); kept here for docs.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_DEVICE_ID=
# SQUARE_APPLICATION_ID=   # optional, client-SDK only
# ISO currency charged at the terminal. Defaults to CAD.
# SQUARE_CURRENCY=CAD

# --- Optional -------------------------------------------------------------
# Connection pool sizing (Postgres). Defaults shown.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
#
# Running WITHOUT Docker (bare host)? Skip the POSTGRES_* vars above and set the
# DSN directly instead:
# DATABASE_URL=postgresql+psycopg://rms:password@localhost:5432/restaurant
