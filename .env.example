# Copy to `.env` and fill in before `docker compose up`. The compose stack reads
# these to configure Postgres, build the app's DATABASE_URL, and seed the owner.
#
#   cp .env.example .env    # then edit the two values marked CHANGE ME

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=rms
# REQUIRED — compose refuses to start without it. Use a long random string.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=restaurant

# --- First-run owner account ---------------------------------------------
# Used once by `python -m app.bootstrap` to create the single owner login on a
# fresh database. 4–8 digits. Change it after first sign-in under Manage.
OWNER_PIN=CHANGE_ME

# --- Session/PIN signing key ---------------------------------------------
# Signs the login cookie and salts PIN hashes (app/security.py). REQUIRED in
# production — set it to a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the app falls back to a public development key (fine locally, unsafe
# in prod). Changing it simply signs everyone out on their next request.
SECRET_KEY=CHANGE_ME

# Set to 1 in production (behind HTTPS, e.g. Render) so the session cookie is
# only ever sent over TLS. Leave unset for local HTTP development.
# COOKIE_SECURE=1

# --- Optional -------------------------------------------------------------
# Connection pool sizing (Postgres). Defaults shown.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
#
# Running WITHOUT Docker (bare host)? Skip the POSTGRES_* vars above and set the
# DSN directly instead:
# DATABASE_URL=postgresql+psycopg://rms:password@localhost:5432/restaurant
